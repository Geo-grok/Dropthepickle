#!/usr/bin/env python3
"""Re-verify pickleball discount codes and rewrite data/discount-codes.json (then optionally rebuild the site).

Every code in data/discount-sources.json is kept only if, today, its creator/brand source page still shows
that code within a short distance after the brand name. Codes that disappear are listed under "removed".
Nothing is invented: new codes are added by hand to data/discount-sources.json.

  python3 scripts/refresh-codes            # verify + write JSON
  python3 scripts/refresh-codes --build    # ...then rebuild dist/ (python3 build.py)
  APIFY_TOKEN=... python3 scripts/refresh-codes --apify   # use Apify's rag-web-browser for pages that
                                           # block a plain fetch (runs on the Apify free monthly credit; no schedules)
"""
import json, re, sys, os, html, datetime, pathlib, subprocess, urllib.request, urllib.parse
ROOT = pathlib.Path(__file__).resolve().parent.parent
SRC, OUT = ROOT / "data/discount-sources.json", ROOT / "data/discount-codes.json"
UA = "Mozilla/5.0 (compatible; DropThePickleBot/1.0; +https://dropthepickle.com/about.html)"
WINDOW = 450  # chars after a brand mention in which the code must appear
MONTHS = "January|February|March|April|May|June|July|August|September|October|November|December"

def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": UA, "Accept": "text/html"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.read().decode("utf-8", "ignore")

def fetch_apify(url):
    tok = os.environ.get("APIFY_TOKEN")
    if not tok: raise RuntimeError("APIFY_TOKEN not set")
    api = ("https://api.apify.com/v2/acts/apify~rag-web-browser/run-sync-get-dataset-items?token=" + tok)
    body = json.dumps({"query": url, "maxResults": 1, "outputFormats": ["markdown"]}).encode()
    req = urllib.request.Request(api, data=body, headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=180) as r:
        items = json.loads(r.read())
    return (items[0].get("markdown") or "") if items else ""

def to_text(doc):
    doc = re.sub(r"(?is)<(script|style|noscript)[^>]*>.*?</\1>", " ", doc)
    doc = re.sub(r"(?s)<[^>]+>", " ", doc)
    return re.sub(r"\s+", " ", html.unescape(doc))

def norm(s): return re.sub(r"[^a-z0-9]", "", s.lower())

def found(text, brand, code):
    t, b, c = text.lower(), brand.lower(), code.lower()
    pat = re.compile(r"(?<![a-z0-9])" + re.escape(c) + r"(?![a-z0-9])")
    for m in re.finditer(re.escape(b), t):
        if pat.search(t, m.start(), m.end() + WINDOW): return True
    # brand written without spaces (e.g. "SixZero")
    nb = norm(brand)
    if nb != b:
        for m in re.finditer(re.escape(nb), t):
            if pat.search(t, m.start(), m.end() + WINDOW): return True
    return False

def source_date(text):
    m = re.search(rf"(?:last verified|last updated|updated on|verified)\s*:?\s*((?:{MONTHS})(?:\s+\d{{1,2}},?)?\s+20\d\d)", text, re.I)
    return m.group(1) if m else None

def pct(d):
    m = re.search(r"(\d+)%", d); n = re.search(r"\$(\d+)", d)
    return int(m.group(1)) if m else (int(n.group(1)) / 2 if n else 1)  # rough sort score; $10 ~ 5%

def main():
    S = json.loads(SRC.read_text()); today = datetime.date.today().isoformat()
    prev = {(c["brand"], c["code"], c["source_url"]): c for c in (json.loads(OUT.read_text()).get("codes", []) if OUT.exists() else [])}
    keep, removed, failed = [], [], []
    for s in S["sources"]:
        text = None
        try: text = to_text(fetch(s["url"]))
        except Exception as ex:
            if "--apify" in sys.argv:
                try: text = to_text(fetch_apify(s["url"]))
                except Exception as ex2: failed.append(f'{s["url"]}: {ex2}')
            else: failed.append(f'{s["url"]}: {ex}')
        sd = source_date(text) if text else None
        for c in s["codes"]:
            key = (c["brand"], c["code"], s["url"])
            rec = {"brand": c["brand"], "code": c["code"], "discount": c["discount"], "conditions": c.get("conditions", ""),
                   "source": s["name"], "source_url": s["url"], "source_date": sd, "expiry": c.get("expiry"),
                   "shop_url": S["shops"].get(c["brand"], ""), "first_seen": (prev.get(key) or {}).get("first_seen", today)}
            if text is None:  # fetch failed: keep yesterday's verification, don't re-stamp it
                if key in prev: keep.append(prev[key])
                continue
            if c.get("expiry") and c["expiry"] < today: removed.append({**rec, "reason": "expired"}); continue
            if found(text, c.get("match", c["brand"]), c["code"]): keep.append({**rec, "verified": today})
            else: removed.append({**rec, "reason": "no longer shown on source page"})
    keep.sort(key=lambda c: (c["brand"].lower(), -pct(c["discount"])))
    out = {"updated": today, "method": "Each code was re-checked today on the creator or brand page listed as its source.",
           "codes": keep, "removed": removed, "no_code": S.get("no_code", {}), "fetch_errors": failed}
    OUT.write_text(json.dumps(out, indent=1, ensure_ascii=False) + "\n")
    print(f"{len(keep)} codes kept across {len({c['brand'] for c in keep})} brands, {len(removed)} removed, {len(failed)} source errors -> {OUT}")
    for f in failed: print("  fetch error:", f)
    for r in removed: print(f'  removed {r["brand"]} {r["code"]} ({r["reason"]})')
    if "--build" in sys.argv: sys.exit(subprocess.call([sys.executable, str(ROOT / "build.py")]))

if __name__ == "__main__": main()
