#!/usr/bin/env python3
"""Submit every URL in the live sitemap to IndexNow (Bing and other engines).

No account. The key file must already be live at https://dropthepickle.com/<key>.txt
(build.py writes it from data/indexnow-key.txt).

  python3 scripts/indexnow-ping
  python3 scripts/indexnow-ping --sitemap dist/sitemap.xml
"""
import json, pathlib, re, sys, urllib.error, urllib.request
ROOT = pathlib.Path(__file__).resolve().parent.parent
KEY = (ROOT / "data" / "indexnow-key.txt").read_text().strip()
HOST = "dropthepickle.com"
ENDPOINT = "https://api.indexnow.org/indexnow"
# Cloudflare rejects the default Python user agent on the sitemap.
UA = "DropThePickle-IndexNow/1.0 (+https://dropthepickle.com)"

def urls_from(src):
    if src.startswith("http"):
        req = urllib.request.Request(src, headers={"User-Agent": UA, "Accept": "application/xml"})
        xml = urllib.request.urlopen(req, timeout=30).read().decode("utf-8", "replace")
    else:
        xml = pathlib.Path(src).read_text()
    return re.findall(r"<loc>\s*([^<]+?)\s*</loc>", xml)

def main():
    src = sys.argv[sys.argv.index("--sitemap") + 1] if "--sitemap" in sys.argv else f"https://{HOST}/sitemap.xml"
    urls = urls_from(src)
    if not re.fullmatch(r"[0-9a-f]{32}", KEY):
        raise SystemExit("data/indexnow-key.txt must be 32 lowercase hex characters")
    if not urls:
        raise SystemExit(f"no URLs in {src}")
    body = json.dumps({
        "host": HOST,
        "key": KEY,
        "keyLocation": f"https://{HOST}/{KEY}.txt",
        "urlList": urls,
    }).encode()
    req = urllib.request.Request(ENDPOINT, data=body, headers={"Content-Type": "application/json; charset=utf-8"})
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            status, text = r.status, r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        status, text = e.code, e.read().decode("utf-8", "replace")
    print(f"IndexNow {status} for {len(urls)} URLs from {src}")
    if text.strip():
        print(text.strip())
    if status not in (200, 202):
        raise SystemExit(1)

if __name__ == "__main__":
    main()
