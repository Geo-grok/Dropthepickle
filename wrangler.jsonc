{
  "name": "dropthepickle",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dtp-subscribers",
      "database_id": "fddb64c4-6f12-4af0-b6ec-aeaf902a70f0"
    }
  ]
}
